---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="留言板" isIndexed={true}>
  <div class="min-h-screen bg-base-200/30 -mt-8 pt-8 pb-20 px-4 sm:px-6 lg:px-8 transition-colors duration-300">
    <div class="max-w-4xl mx-auto space-y-10 mt-10">
      
      <div class="text-center space-y-4 animate-fade-in-up">
        <h1 class="text-3xl md:text-4xl font-bold text-base-content">留言板</h1>
        <p class="text-base-content/60">欢迎来到我的主页！有什么想说的都可以留在这里哦 ~</p>
      </div>

      <div class="bg-base-100 rounded-3xl p-6 md:p-8 shadow-sm transition-all duration-300">
        <div id="tcomment"></div>
      </div>

      <div class="divider my-6 animate-fade-in-up" style="animation-delay: 0.1s;">
        <Icon name="lucide:message-circle-heart" class="w-12 h-12 text-primary/50" />
      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline src="https://cdn.staticfile.net/twikoo/1.6.39/twikoo.all.min.js"></script>

<script is:inline>
  function initTwikoo() {
    if (typeof twikoo !== 'undefined') {
      twikoo.init({
        // 这里填写你通过宝塔绑定的带 https 的二级域名
        envId: 'https://comment.你的域名.com', 
        el: '#tcomment',
        path: window.location.pathname,
      });
    }
  }

  // 必须绑定 astro:page-load，保证在 Astro View Transitions 路由切换时不丢失评论框
  document.addEventListener('astro:page-load', initTwikoo);
</script>
