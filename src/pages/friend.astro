---

<BaseLayout title="照片墙" isIndexed={false}>
  <!-- 页面头部 -->
  <div class="mb-10 animate-fade-in-up">
    <h1 class="text-3xl md:text-4xl font-bold mb-4 flex items-center gap-3">
      <!-- 把之前的 user 图标换成了 camera（相机）或 image 图标 -->
      <Icon name="lucide:camera" class="text-primary" />
      <span>土豆的照片墙</span>
    </h1>
    <p class="text-base-content/70 text-lg mb-6">
      记录我家猫咪可爱的日常瞬间 🐾
    </p>
    
    <!-- 瀑布流照片墙主体区 -->
    <!-- 使用 Tailwind 的 columns 语法实现瀑布流排版：手机1列，平板2列，大屏3列 -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {photos.map((photo) => (
        <div class="break-inside-avoid bg-base-100 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-base-200 group">
          <!-- 图片区域（带悬停放大效果） -->
          <div class="relative overflow-hidden">
            <img 
              src={photo.url} 
              alt={photo.title} 
              class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
            />
          </div>
          <!-- 文字描述区域（如果不需要文字，可以把这一块删掉） -->
          <div class="p-5">
            <h3 class="text-xl font-bold mb-2">{photo.title}</h3>
            <p class="text-base-content/70 text-sm">{photo.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 底部装饰线（保留了原主题的爱心装饰） -->
  <div class="divider my-6 animate-fade-in-up" style="animation-delay: 0.1s;">
    <Icon name="lucide:heart" class="w-12 h-12 text-primary/50" />
  </div>
</BaseLayout>
